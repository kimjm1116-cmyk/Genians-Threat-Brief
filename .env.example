# OpenAI (위협 현황 분석)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o

# Slack Bot Token 업로드 (files_upload_v2)
# Incoming Webhook으로는 이미지 업로드가 안 됩니다.
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_CHANNEL_ID=C0123456789
SLACK_WEBHOOK_URL=
SLACK_ALERT_WEBHOOK_URL=

# 선택: NewsAPI.org
NEWSAPI_KEY=

# 수집·리포트 설정
LOOKBACK_HOURS=24
MAX_COLLECTED_ARTICLES=100
MAX_REPORT_ROWS=12
TZ=Asia/Seoul
